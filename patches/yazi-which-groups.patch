+		assert_eq!(show(&cands, 2), ["z Zip", "t Tar"]);
+	}
+
+	#[test]
+	fn a_label_without_a_description_counts() {
+		let cands = [
+			chord("<Space> a", "", ""),
+			chord("<Space> a z", "quit", "Zip"),
+			chord("<Space> a t", "quit", "Tar"),
