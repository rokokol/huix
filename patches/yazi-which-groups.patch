+			chord("<Space> c", "quit", "Close"),
+			chord("<Space> a z", "quit", "Zip"),
+			chord("<Space> a", "", "Archive"),
+			chord("<Space> a t", "quit", "Tar"),
+			chord("<Space> u h", "quit", "Hidden"),
+			chord("<Space> u g", "quit", "Git"),
+			chord("<Space> g g", "quit", "LazyGit"),
+			chord("<Space> m", "", "Empty"),
+		];
+		assert_eq!(show(&cands, 1), ["c Close", "a +Archive", "u +2", "gg LazyGit"]);
+	}
+
+	#[test]
+	fn a_typed_group_shows_its_chords() {
+		let cands = [
+			chord("<Space> a", "", "Archive"),
+			chord("<Space> a z", "quit", "Zip"),
+			chord("<Space> a t", "quit", "Tar"),
