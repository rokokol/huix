+			on: on.split(' ').map(|k| k.parse().unwrap()).collect(),
+			run: if run.is_empty() { Default::default() } else { vec![run.parse().unwrap()].into() },
+			desc: desc.to_owned(),
+			..Default::default()
+		}
+		.into()
+	}
+
+	fn rows(cands: &[ChordArc], times: usize, fold: bool) -> Vec<String> {
+		Cand::rows(cands, times, fold).iter().map(|r| format!("{} {}", r.keys().join(""), r.desc())).collect()
+	}
+
+	fn show(cands: &[ChordArc], times: usize) -> Vec<String> { rows(cands, times, true) }
+
+	#[test]
+	fn without_fold_every_chord_is_a_row() {
+		let cands = [
+			chord("<Space> c", "quit", "Close"),
+			chord("<Space> a", "", "Archive"),
+			chord("<Space> a z", "quit", "Zip"),
