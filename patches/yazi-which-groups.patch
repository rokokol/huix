+#[cfg(test)]
+mod tests {
+	use std::sync::Once;
+
+	use yazi_config::keymap::Chord;
+
+	use super::*;
+
+	fn chord(on: &str, run: &str) -> ChordArc {
+		Chord {
+			on: on.split(' ').map(|k| k.parse().unwrap()).collect(),
+			run: if run.is_empty() { Default::default() } else { vec![run.parse().unwrap()].into() },
+			..Default::default()
+		}
+		.into()
+	}
+
+	/// What typing `keys` after the first key picks: `None` while the which component stays
+	/// open, `Some(None)` for a dismissal, and `Some(Some(keys))` for the chord it runs.
+	fn pick(cands: Vec<ChordArc>, keys: &str) -> Option<Option<String>> {
+		static INIT: Once = Once::new();
+		INIT.call_once(yazi_shared::init);
+
+		let (tx, mut rx) = mpsc::unbounded_channel();
+		let mut which = Which { tx: Some(tx), cands, times: 1, active: true, ..Default::default() };
+		for key in keys.split(' ') {
+			which.r#type(key.parse().unwrap());
+		}
+		rx.try_recv().ok().map(|c| c.map(|c| c.on()))
+	}
+
+	#[test]
+	fn label_does_not_end_the_chord() {
+		let cands =
+			vec![chord("<Space> a", ""), chord("<Space> a z", "quit"), chord("<Space> a t", "quit")];
+		assert_eq!(pick(cands.clone(), "a"), None);
+		assert_eq!(pick(cands, "a z"), Some(Some("<Space>az".to_owned())));
+	}
+
+	#[test]
+	fn label_is_not_a_second_match() {
+		let cands =
+			vec![chord("<Space> a", ""), chord("<Space> a z", "quit"), chord("<Space> b", "quit")];
+		assert_eq!(pick(cands, "a"), Some(Some("<Space>az".to_owned())));
+	}
+
+	#[test]
+	fn label_alone_dismisses() {
+		let cands =
+			vec![chord("<Space> a", ""), chord("<Space> b", "quit"), chord("<Space> c", "quit")];
+		assert_eq!(pick(cands, "a"), Some(None));
+	}
+
+	#[test]
+	fn chords_without_labels_work_as_before() {
+		let cands =
+			vec![chord("<Space> a z", "quit"), chord("<Space> a t", "quit"), chord("<Space> b", "quit")];
+		assert_eq!(pick(cands.clone(), "a"), None);
+		assert_eq!(pick(cands, "b"), Some(Some("<Space>b".to_owned())));
+	}
+}
