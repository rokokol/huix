+static void
+record_touch_action(void *data, PyObject *action) {
+    if (!action || PyList_Append(data, action) != 0) PyErr_Clear();
+    Py_XDECREF(action);
+}
+
+static void
+record_touch_move(void *data, double x, double y) {
+    record_touch_action(data, Py_BuildValue("sdd", "move", x, y));
+}
+
+static void
+record_touch_button(void *data, int action, int mods UNUSED) {
+    record_touch_action(data, Py_BuildValue("(s)", action == GLFW_PRESS ? "press" : "release"));
+}
+
+static void
+record_touch_scroll(void *data, double dx, double dy, bool finger_lifted, int mods UNUSED) {
+    record_touch_action(data, Py_BuildValue("sddO", "scroll", dx, dy, finger_lifted ? Py_True : Py_False));
+}
+
+static void
+record_touch_cancel_scroll(void *data) {
+    record_touch_action(data, Py_BuildValue("(s)", "cancel_scroll"));
+}
+
+static PyObject *
+test_touch_to_mouse(PyObject *self UNUSED, PyObject *args) {
+    PyObject *events;
+    if (!PyArg_ParseTuple(args, "O!", &PyList_Type, &events)) return NULL;
+    static const char *types[] = {"", "begin", "update", "end", "cancel"};
+    static const char *states[] = {"", "pressed", "moved", "stationary", "released"};
+    PyObject *ans = PyList_New(0);
+    if (!ans) return NULL;
+    TouchToMouse s = {0};
+    const TouchToMouseSink sink = {
+        .move = record_touch_move,
+        .button = record_touch_button,
+        .scroll = record_touch_scroll,
+        .cancel_scroll = record_touch_cancel_scroll,
+        .data = ans,
+    };
+    GLFWTouchPoint points[16];
+    for (Py_ssize_t i = 0; i < PyList_GET_SIZE(events); i++) {
+        long long ms;
+        const char *type;
+        PyObject *pts;
+        if (!PyArg_ParseTuple(PyList_GET_ITEM(events, i), "LsO!", &ms, &type, &PyTuple_Type, &pts)) goto error;
+        GLFWTouchEvent ev = {.points = points, .num_points = MIN((size_t)PyTuple_GET_SIZE(pts), arraysz(points))};
+        for (size_t t = 1; t < arraysz(types); t++)
+            if (strcmp(type, types[t]) == 0) ev.type = (GLFWTouchEventType)t;
+        for (size_t p = 0; p < ev.num_points; p++) {
+            const char *state;
+            int id;
+            if (!PyArg_ParseTuple(PyTuple_GET_ITEM(pts, p), "isdd", &id, &state, &points[p].x, &points[p].y)) goto error;
+            points[p].id = id;
+            points[p].state = 0;
+            for (size_t t = 1; t < arraysz(states); t++)
+                if (strcmp(state, states[t]) == 0) points[p].state = (GLFWTouchPointState)t;
+        }
+        if (!ev.type) {
+            PyErr_Format(PyExc_ValueError, "Unknown touch event type: %s", type);
+            goto error;
+        }
+        touch_to_mouse(&s, &ev, ms_to_monotonic_t(ms), &sink);
+    }
+    return ans;
+error:
+    Py_DECREF(ans);
+    return NULL;
+}
