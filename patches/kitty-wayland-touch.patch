+        .id = id,
+        .window_id = window->id,
+        .state = GLFW_TOUCH_POINT_PRESSED,
+        .pressed_in_frame = true,
+        .x = wl_fixed_to_double(sx),
+        .y = wl_fixed_to_double(sy),
