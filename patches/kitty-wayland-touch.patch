+// A finger that stays within the tap slop is a left click at the place it
+// landed, sent as a press and a release when it lifts, so a finger that moves
+// is never a click. A finger that moves at once scrolls along both axes, the
+// way a touchpad does, and carries on under momentum after it lifts. A finger
+// held still for TOUCH_SELECT_HOLD before it moves is a left button dragged
+// from where it landed, which selects text as a mouse drag does
+#define TOUCH_TAP_SLOP 8.0
+#define TOUCH_SELECT_HOLD ms_to_monotonic_t(400)
+
+void
+touch_to_mouse(TouchToMouse *s, const GLFWTouchEvent *ev, monotonic_t now, const TouchToMouseSink *sink) {
+    const int mods = ev->keyboard_modifiers;
+    if (ev->type == GLFW_TOUCH_CANCEL) {
+        // A selection in progress lets its button go, so it is not left held down
+        if (s->active && s->selecting) sink->button(sink->data, GLFW_RELEASE, mods);
+        *s = (TouchToMouse){0};
+        sink->cancel_scroll(sink->data);
+        return;
+    }
+    if (ev->type == GLFW_TOUCH_BEGIN) s->active = false;
+    if (!s->active) {
+        for (size_t i = 0; i < ev->num_points; i++) {
+            if (ev->points[i].state != GLFW_TOUCH_POINT_PRESSED) continue;
+            *s = (TouchToMouse){.active = true, .id = ev->points[i].id, .x = ev->points[i].x, .y = ev->points[i].y, .down_at = now};
+            sink->cancel_scroll(sink->data);
+            break;
+        }
+        return;
+    }
+    const GLFWTouchPoint *p = NULL;
+    for (size_t i = 0; i < ev->num_points && !p; i++)
+        if (ev->points[i].id == s->id) p = ev->points + i;
+    if (!p) return;
+    switch (p->state) {
+        case GLFW_TOUCH_POINT_MOVED:
+            if (!s->moved) {
+                if (fabs(p->x - s->x) <= TOUCH_TAP_SLOP && fabs(p->y - s->y) <= TOUCH_TAP_SLOP) return;
+                s->moved = true;
+                // The pointer goes to where the finger landed, so that what
+                // follows reaches the window under the finger
+                sink->move(sink->data, s->x, s->y);
+                if (now - s->down_at >= TOUCH_SELECT_HOLD) {
+                    s->selecting = true;
+                    sink->button(sink->data, GLFW_PRESS, mods);
+                }
+            }
+            if (s->selecting) sink->move(sink->data, p->x, p->y);
+            else sink->scroll(sink->data, p->x - s->x, p->y - s->y, false, mods);
+            s->x = p->x;
+            s->y = p->y;
+            break;
+        case GLFW_TOUCH_POINT_RELEASED:
+            s->active = false;
+            if (s->selecting) sink->button(sink->data, GLFW_RELEASE, mods);
+            else if (s->moved) sink->scroll(sink->data, 0, 0, true, mods);
+            else {
+                sink->move(sink->data, s->x, s->y);
+                sink->button(sink->data, GLFW_PRESS, mods);
+                sink->button(sink->data, GLFW_RELEASE, mods);
+            }
+            break;
+        case GLFW_TOUCH_POINT_PRESSED:
+        case GLFW_TOUCH_POINT_STATIONARY: break;
+    }
+}
+
+#undef TOUCH_TAP_SLOP
+#undef TOUCH_SELECT_HOLD
