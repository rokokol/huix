--- /dev/null
+++ b/yazi-actor/src/which/reveal.rs
@@ -0,0 +1,26 @@
+use anyhow::Result;
+use yazi_macro::{render, succ};
+use yazi_parser::VoidForm;
+use yazi_shared::data::Data;
+
+use crate::{Actor, Ctx};
+
+pub struct Reveal;
+
+impl Actor for Reveal {
+	type Form = VoidForm;
+
+	const NAME: &str = "reveal";
+
+	fn act(cx: &mut Ctx, _: Self::Form) -> Result<Data> {
+		let which = &mut cx.which;
+
+		// Only the component the timer was started for, and only while it is still open
+		if which.reveal.take().is_none() || !which.active {
+			succ!();
+		}
+
+		which.silent = false;
+		succ!(render!());
+	}
+}
