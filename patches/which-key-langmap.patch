diff --git a/lua/which-key/util.lua b/lua/which-key/util.lua
index 0aa2b44..6bc0f4c 100644
--- a/lua/which-key/util.lua
+++ b/lua/which-key/util.lua
@@ -4,8 +4,67 @@ M.cache = {
   keys = {}, ---@type table<string, string[]>
   norm = {}, ---@type table<string, string>
   termcodes = {}, ---@type table<string, string>
+  langmap = {}, ---@type table<string, table<string, string>>
 }

+--- Parses a 'langmap' value into a table from a typed character to the one it
+--- stands for. Both forms are read: "aAbB" pairs and "ab;AB" lists, with a
+--- backslash escaping the next character
+---@param opt string
+---@return table<string, string>
+function M.parse_langmap(opt)
+  if M.cache.langmap[opt] then
+    return M.cache.langmap[opt]
+  end
+  local ret = {} ---@type table<string, string>
+  local part, semi = {}, nil ---@type string[], number?
+  local function flush()
+    if semi then
+      -- Neovim refuses a list whose two sides differ in length
+      for i = 1, semi do
+        ret[part[i]] = part[semi + i]
+      end
+    else
+      for i = 1, #part - 1, 2 do
+        ret[part[i]] = part[i + 1]
+      end
+    end
+    part, semi = {}, nil
+  end
+  local escaped = false
+  for _, nr in ipairs(vim.fn.str2list(opt)) do
+    local char = vim.fn.nr2char(nr)
+    if escaped then
+      part[#part + 1], escaped = char, false
+    elseif char == "\\" then
+      escaped = true
+    elseif char == "," then
+      flush()
+    elseif char == ";" and not semi then
+      semi = #part
+    else
+      part[#part + 1] = char
+    end
+  end
+  flush()
+  M.cache.langmap[opt] = ret
+  return ret
+end
+
+--- The key 'langmap' turns a typed key into, in the modes where Neovim applies
+--- the option, or nil. Neovim does not apply it to keys a plugin reads with
+--- getchar(), so which-key does it itself
+---@param mode string
+---@param key string
+---@return string?
+function M.langmap(mode, key)
+  if not mode:find("^[nxso]") or vim.o.langmap == "" then
+    return
+  end
+  local mapped = M.parse_langmap(vim.o.langmap)[key]
+  return mapped and vim.fn.keytrans(mapped)
+end
+
 function M.t(str)
   M.cache.termcodes[str] = M.cache.termcodes[str] or vim.api.nvim_replace_termcodes(str, true, true, true)
   return M.cache.termcodes[str]
diff --git a/tests/util_spec.lua b/tests/util_spec.lua
index dd3546f..adf30f2 100644
--- a/tests/util_spec.lua
+++ b/tests/util_spec.lua
@@ -123,3 +123,37 @@ describe("modes", function()
     end)
   end
 end)
+
+describe("langmap", function()
+  it("parses pairs, lists and escapes", function()
+    local map = Util.parse_langmap("фa,ыs,б\\,,ж\\;,ЖЭ;:\\\"")
+    assert.same("a", map["ф"])
+    assert.same("s", map["ы"])
+    assert.same(",", map["б"])
+    assert.same(";", map["ж"])
+    assert.same(":", map["Ж"])
+    assert.same('"', map["Э"])
+    assert.is_nil(map[","])
+  end)
+
+  it("reads a second semicolon in a list as a character", function()
+    local map = Util.parse_langmap("ab;A;")
+    assert.same("A", map["a"])
+    assert.same(";", map["b"])
+  end)
+
+  it("applies in normal, visual, select and operator-pending mode only", function()
+    local old = vim.o.langmap
+    vim.o.langmap = "фa,б<"
+    assert.same("a", Util.langmap("n", "ф"))
+    assert.same("a", Util.langmap("x", "ф"))
+    assert.same("a", Util.langmap("o", "ф"))
+    assert.same("<lt>", Util.langmap("n", "б"))
+    assert.is_nil(Util.langmap("i", "ф"))
+    assert.is_nil(Util.langmap("c", "ф"))
+    assert.is_nil(Util.langmap("n", "a"))
+    vim.o.langmap = ""
+    assert.is_nil(Util.langmap("n", "ф"))
+    vim.o.langmap = old
+  end)
+end)
