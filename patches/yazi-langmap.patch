diff --git a/yazi-config/src/keymap/langmap.rs b/yazi-config/src/keymap/langmap.rs
new file mode 100644
index 0000000..87042a2
--- /dev/null
+++ b/yazi-config/src/keymap/langmap.rs
@@ -0,0 +1,20 @@
+use hashbrown::HashMap;
+use serde::{Deserialize, Deserializer};
+use yazi_shim::toml::{DeserializeOverHook, DeserializeOverWith};
+
+use super::Key;
+
+#[derive(Default, Deserialize)]
+pub struct Langmap(HashMap<char, char>);
+
+impl Langmap {
+	pub fn translate(&self, key: Key) -> Key { key.langmapped(&self.0) }
+}
+
+impl DeserializeOverWith for Langmap {
+	fn deserialize_over_with<'de, D: Deserializer<'de>>(self, de: D) -> Result<Self, D::Error> {
+		self.0.deserialize_over_with(de).map(Self)
+	}
+}
+
+impl DeserializeOverHook for Langmap {}
